---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonicalUrl?: string;
  bodyClass?: string;
  textHref?: string;
  showCheckShortcut?: boolean;
  postcardOnly?: boolean;
  callrailId?: string;
}

const {
  title = "Tank & Trench | AI Search for Septic & Excavation",
  description = "We help septic and excavation contractors get found when homeowners and builders ask ChatGPT, Claude and Google’s AI who to call.",
  noindex = false,
  canonicalUrl,
  bodyClass = "has-mobile-bar",
  textHref,
  showCheckShortcut = false,
  postcardOnly = false,
  callrailId = "" // Set via prop or PUBLIC_CALLRAIL_COMPANY_ID when active
} = Astro.props;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';

const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site || 'https://tankandtrench.com';
const resolvedCanonical = canonicalUrl || new URL(currentPath, siteOrigin).href;
const ogImageUrl = new URL('/images/og-preview.png', siteOrigin).href;
const resolvedCallrailId = callrailId || import.meta.env.PUBLIC_CALLRAIL_COMPANY_ID || "";
const resolvedGaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex ? (
    <meta name="robots" content="noindex, nofollow, noarchive">
  ) : (
    <meta name="robots" content="index, follow">
  )}
  <link rel="canonical" href={resolvedCanonical}>

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <link rel="apple-touch-icon" href="/favicon.svg">

  <!-- Typography Preconnects -->
  {!postcardOnly && <Fragment>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  </Fragment>}

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/styles.css">

  <!-- OpenGraph & Link Preview -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={resolvedCanonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Tank & Trench">
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Tank & Trench — AI Search for Septic & Excavation">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- Simple Visit Analytics (GA4) -->
  {resolvedGaId && (
    <Fragment>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${resolvedGaId}`}></script>
      <script is:inline define:vars={{ resolvedGaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', resolvedGaId);
      </script>
    </Fragment>
  )}

  <!-- CallRail Dynamic Number Insertion (DNI) -->
  {resolvedCallrailId && (
    <script type="text/javascript" src={`//cdn.callrail.com/companies/${resolvedCallrailId}/12/swap.js`} async></script>
  )}

  <slot name="head" />
</head>
<body class={bodyClass}>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {!postcardOnly && <Header textHref={textHref} checkHref={showCheckShortcut ? "#check-form" : "/check/#check-form"} />}

  <main id="main-content">
    <slot />
  </main>

  <MobileStickyBar textHref={textHref} showCheckShortcut={showCheckShortcut} />
  {!postcardOnly && <Footer textHref={textHref} />}

  <!-- Interaction Scripts: Condensed Sticky Navbar + Mobile Drawer -->
  <script is:inline>
    // 1. Sticky condensed navbar on scroll
    const navbarWrapper = document.getElementById('navbarWrapper');
    if (navbarWrapper) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          navbarWrapper.classList.add('scrolled');
        } else {
          navbarWrapper.classList.remove('scrolled');
        }
      }, { passive: true });
    }

    // 2. Mobile Drawer Navigation
    const mobileDrawer = document.getElementById('mobileDrawer');
    const drawerOpen = document.getElementById('drawerOpen');
    const drawerClose = document.getElementById('drawerClose');

    function openDrawer() {
      if (!mobileDrawer) return;
      mobileDrawer.hidden = false;
      mobileDrawer.classList.add('open');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      if (drawerOpen) drawerOpen.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!mobileDrawer) return;
      mobileDrawer.classList.remove('open');
      mobileDrawer.setAttribute('aria-hidden', 'true');
      mobileDrawer.hidden = true;
      if (drawerOpen) drawerOpen.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    window.closeDrawer = closeDrawer;

    if (drawerOpen && mobileDrawer && drawerClose) {
      drawerOpen.addEventListener('click', openDrawer);
      drawerClose.addEventListener('click', closeDrawer);
      mobileDrawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeDrawer);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileDrawer.classList.contains('open')) {
          closeDrawer();
        }
      });
    }
  </script>
</body>
</html>
