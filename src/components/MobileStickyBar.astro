---
import contact from '../data/contact.json';

const { textHref = 'sms:' + contact.number, showCheckShortcut = false } = Astro.props;
---
<div class="mobile-sticky-bar" aria-label="Mobile quick actions">
  <a href={textHref} class="mobile-sticky-btn mobile-sticky-check">Text Joe</a>
  <a href={'tel:' + contact.number} class="mobile-sticky-btn mobile-sticky-call">Call Joe</a>
  {showCheckShortcut && <a href="#check-form" class="mobile-sticky-btn mobile-sticky-form">Go to form</a>}
</div>
