---
import contact from '../data/contact.json';

const { textHref = 'sms:' + contact.number, checkHref = '/check/#check-form' } = Astro.props;
const phoneNumber = contact.display;
const phoneTel = 'tel:' + contact.number;
---
<!-- Mobile Drawer Menu -->
<div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
  <div>
    <div class="drawer-header">
      <div class="nav-brand">
        <a href="/" style="display: inline-flex;">
          <img class="brand-logo" src="/images/tank-and-trench-logo.svg" alt="Tank & Trench" width="200" height="38" onerror="this.onerror=null; this.src='/favicon.svg';">
        </a>
      </div>
      <button class="drawer-close" id="drawerClose" aria-label="Close menu">&times;</button>
    </div>
    <ul class="drawer-links">
      <li><a href="/#how-it-works" class="drawer-link" onclick="closeDrawer()">How it works</a></li>
      <li><a href="/pricing/" class="drawer-link" onclick="closeDrawer()">Pricing</a></li>
      <li><a href="/about/" class="drawer-link" onclick="closeDrawer()">About</a></li>
    </ul>
  </div>
  <div class="drawer-footer">
    <a href={textHref} class="btn btn-secondary btn-lg" style="width: 100%;">Text Joe</a>
    <a href={phoneTel} class="btn btn-secondary btn-lg" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span>Call Joe: {phoneNumber}</span>
    </a>
    <a href={checkHref} class="btn btn-primary btn-lg" style="width: 100%;" onclick="closeDrawer()">Get your free AI check</a>
  </div>
</div>

<!-- Sticky Desktop Navigation Bar -->
<div class="navbar-wrapper" id="navbarWrapper">
  <div class="container-wide">
    <nav class="navbar" aria-label="Primary">
      <a href="/" class="nav-brand">
        <img class="brand-logo" src="/images/tank-and-trench-logo.svg" alt="Tank & Trench" width="200" height="38" onerror="this.onerror=null; this.src='/favicon.svg';">
      </a>

      <ul class="nav-menu">
        <li><a href="/#how-it-works" class="nav-link">How it works</a></li>
        <li><a href="/pricing/" class="nav-link">Pricing</a></li>
        <li><a href="/about/" class="nav-link">About</a></li>
      </ul>

      <div class="nav-actions">
        <a href={textHref} class="nav-phone nav-text">Text Joe</a>
        <a href={phoneTel} class="nav-phone" style="align-items: center; gap: 6px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>{phoneNumber}</span>
        </a>
        <a href={checkHref} class="btn btn-primary btn-sm">Get your free AI check</a>
        <button class="mobile-toggle" id="drawerOpen" aria-label="Open navigation menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</div>
