---
import contact from '../data/contact.json';

const { textHref = 'sms:' + contact.number } = Astro.props;
const phoneNumber = contact.display;
const phoneTel = 'tel:' + contact.number;
---
<footer class="simple-footer">
  <div class="container">
    <div class="simple-footer-inner">
      <div class="simple-footer-top">
        <div>
          <a href="/" style="display: inline-block;">
            <img class="brand-logo" src="/images/tank-and-trench-logo-light.svg" alt="Tank & Trench" width="190" height="36" onerror="this.onerror=null; this.src='/favicon.svg';">
          </a>
          <p style="font-size: 14px; color: rgba(255, 255, 255, 0.7); max-width: 480px; margin-top: 10px; line-height: 1.5;">
            AI Search for Septic &amp; Excavation. When homeowners and builders ask who to call, the answer should be you.
          </p>
        </div>

        <div class="simple-footer-contacts">
          <a href={textHref} class="simple-footer-contact-link">Text Joe</a>
          <a href={phoneTel} class="simple-footer-contact-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{phoneNumber}</span>
          </a>

          <a href="mailto:joe@tankandtrench.com" class="simple-footer-contact-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>joe@tankandtrench.com</span>
          </a>
        </div>
      </div>

      <div class="simple-footer-bottom">
        <div>
          Tank &amp; Trench is operated by Shellback Labs LLC. &copy; 2026 Shellback Labs LLC d/b/a Tank &amp; Trench. All rights reserved.
        </div>

        <div class="simple-footer-legal-links">
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Use</a>
        </div>
      </div>
    </div>
  </div>
</footer>
