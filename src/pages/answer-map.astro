---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "The Answer Map | Tank & Trench";
const pageDesc = "The site-plan analogy, 3-step process, and sample monthly call report behind the Tank & Trench Answer Map for septic and excavation contractors.";
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- Subpage Hero -->
  <section class="page-hero">
    <div class="page-hero-mask"></div>
    <div class="container-narrow page-hero-content">
      <div class="eyebrow cobalt">Proprietary Architecture</div>
      <h1 class="display-lg" style="margin-bottom: 18px;">
        The Answer Map: an asset you own, <span class="highlight-chip highlight-cobalt">not a monthly chore</span>
      </h1>
      <p class="body-lg" style="max-width: 640px; margin: 0 auto 28px;">
        Every client gets an Answer Map: their services, towns, equipment fleet, and local septic regulations mapped into an interconnected entity graph. Built once, owned by you, and expanding monthly.
      </p>
      <div>
        <a href="/check/" class="btn btn-primary btn-md">Get your free AI check</a>
      </div>
    </div>
  </section>

  <!-- The Site-Plan Analogy Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow">The Engineering Analogy</div>
        <h2 class="display-md">
          Why septic contractors understand the <span class="highlight-chip highlight-sun">site-plan principle</span>
        </h2>
        <p class="body-lg section-intro">
          You would never run a 30-ton excavator onto raw land without an engineered site plan showing benchmarks, perc test pits, leach line runs, and distribution box elevations.
        </p>
      </div>

      <div style="max-width: 820px; margin: 0 auto; background: var(--bg-subtle); padding: clamp(28px, 4vw, 44px); border-radius: var(--radius-lg); border: 1px solid var(--border-default);">
        <p class="body-md" style="color: var(--ink-700); margin-bottom: 16px;">
          Most search agencies dump generic blog posts and random backlinks onto a website without a blueprint. That is like dropping gravel in a ditch and calling it a foundation.
        </p>
        <p class="body-md" style="color: var(--ink-700); margin-bottom: 16px;">
          The Answer Map is the engineered site plan for your digital presence. Before writing a single sentence, we map out every service code (routine pumping, emergency cleanouts, perc test digging, D-box replacement), every town perimeter in your county, every truck tank capacity in your yard, and every state health code requirement.
        </p>
        <p class="body-md" style="color: var(--ink-700); font-weight: 500;">
          When a homeowner opens Google or asks ChatGPT who pumps septic tanks in their town, the search engine does not guess. It consults your Answer Map.
        </p>

        <div style="margin-top: 28px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-default);">
          <img src="/images/diagram-site-plan-analogy.jpg" alt="Site plan blueprint transitioning into an Answer Map semantic knowledge graph" width="1200" height="675" loading="lazy" style="width: 100%; display: block; object-fit: cover;" onerror="this.parentElement.style.display='none';">
        </div>
      </div>
    </div>
  </section>

  <!-- 3-Step Process -->
  <section class="section-padding" style="background-color: var(--bg-subtle); border-top: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow cobalt">3-Step Implementation</div>
        <h2 class="display-md">
          How we build and deploy <span class="highlight-chip highlight-cobalt">your Answer Map</span>
        </h2>
        <p class="body-lg section-intro">
          We handle the heavy lifting. Built for owner-operators and office managers with zero marketing staff.
        </p>
      </div>

      <div class="how-it-works-grid">
        <!-- Step 1 -->
        <div class="step-card">
          <div class="step-num-badge">01</div>
          <h3 class="step-title">County &amp; Fleet Inventory</h3>
          <p class="step-body">
            We catalog your exact service capabilities: pump truck capacities, excavators, state license numbers, Title 5 or county health board certifications, emergency hours, and every target town in your county boundary.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="step-card">
          <div class="step-num-badge">02</div>
          <h3 class="step-title">Knowledge Graph Compilation</h3>
          <p class="step-body">
            Compiled into custom schema (Organization, LocalBusiness, Service, FAQPage). We generate dedicated service and town hubs with zero thin content so AI assistants accurately categorize you.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="step-card">
          <div class="step-num-badge">03</div>
          <h3 class="step-title">Call Tracking &amp; Expansion</h3>
          <p class="step-body">
            Dynamic call tracking activates on day one. Every month we add new town permit answers, review citations, and monitor how AI assistants like ChatGPT, Perplexity, and Google AI Overviews answer septic queries.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contrast Table -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow coral">Clear Comparison</div>
        <h2 class="display-md">
          An owned asset vs. a <span class="highlight-chip highlight-coral">monthly agency chore</span>
        </h2>
      </div>

      <div class="table-responsive-wrapper">
        <table class="pricing-table">
          <thead>
            <tr>
              <th style="width: 25%;">Factor</th>
              <th style="width: 37%;">Generic SEO Agency</th>
              <th class="featured-col" style="width: 38%;">Tank &amp; Trench Answer Map</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Core Deliverable</strong></td>
              <td>Vague "SEO hours" and generic blog articles</td>
              <td class="featured-col"><strong>A named entity asset: The Answer Map</strong></td>
            </tr>
            <tr>
              <td><strong>Primary Metric</strong></td>
              <td>Impression spikes and search visibility indexes</td>
              <td class="featured-col"><strong>Inbound phone calls and form submissions</strong></td>
            </tr>
            <tr>
              <td><strong>Trade Knowledge</strong></td>
              <td>Writers who have never seen a septic tank</td>
              <td class="featured-col"><strong>Specialists who know D-boxes, perc tests, and pump trucks</strong></td>
            </tr>
            <tr>
              <td><strong>Ownership</strong></td>
              <td>Proprietary builder locked to agency</td>
              <td class="featured-col"><strong>100% owned by the contractor</strong></td>
            </tr>
            <tr>
              <td><strong>Competitor Conflict</strong></td>
              <td>Takes your competitor down the road if they pay</td>
              <td class="featured-col"><strong style="color: var(--mint-500);">County Exclusivity: One company per county per side (Tank or Trench)</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-padding" style="background: var(--white); text-align: center; border-top: 1px solid var(--border-subtle);">
    <div class="container-narrow">
      <div class="eyebrow sun" style="justify-content: center; margin-bottom: 12px;">Free AI Check</div>
      <h2 class="display-lg" style="margin-bottom: 20px;">
        Find out what the AI says about you. Free, five minutes of your time, and you get a short video walkthrough.
      </h2>
      <div style="margin-top: 32px;">
        <a href="/check/" class="btn btn-primary btn-lg">
          <span>Get your free AI check</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
