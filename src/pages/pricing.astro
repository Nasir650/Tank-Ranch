---
import contact from '../data/contact.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import TradeSelect from '../components/TradeSelect.astro';

const pageTitle = "Pricing & Plans | Tank & Trench";
const pageDesc = "Pro is $750 a month. Territory is $1,250 a month and includes exclusivity for your side in your county. 6-month minimum, then month to month.";

const pricingFaqs = [
  [
    "Do I need a website already?",
    "No. If you don't have one, we build a custom WordPress site (service pages, town pages, and schema) in the first 30 days, included with both plans. Hosting is included while you're a client, and after 6 months it's yours."
  ],
  [
    "What happens to my website if I cancel?",
    "Both plans have a 6-month minimum, then continue month to month. If you leave after 6 months, you own the site we built and we hand it over so you can take over hosting. If you cancel before 6 months, you can pay the remaining months of the term or pay a one-time $1,500 website buyout to keep the site; otherwise the site comes down."
  ],
  [
    "Do you run ads?",
    "Yes, as an add-on for Pro and Territory clients. Ads bring in calls right away while AI search builds. Options include Local Services Ads ($300/mo), Google Search Ads ($500/mo), Ads Bundle: LSA + Search ($700/mo), Social media ($350/mo), and Meta ads ($350/mo)."
  ],
  [
    "Which states do you work in?",
    "Anywhere in the US. Tell Joe your state and the counties you cover, and he'll confirm which sides are open for Territory."
  ],
];

const websiteTooltipText = "No website? We build one, included with your plan. 6-month minimum, then month to month. After 6 months, the site is yours. Leave earlier and you can keep it for a one-time $1,500 buyout.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://tankandtrench.com/#organization",
      name: "Tank & Trench",
      legalName: "Shellback Labs LLC",
      url: "https://tankandtrench.com/",
      logo: "https://tankandtrench.com/images/tank-and-trench-logo.svg",
      email: "joe@tankandtrench.com",
      telephone: contact.number,
    },
    {
      "@type": "Service",
      "@id": "https://tankandtrench.com/pricing/#service",
      name: "Tank & Trench AI Search Plans",
      serviceType: "Local SEO, AI Search Optimization, and Contractor Website & Ads Management",
      provider: { "@id": "https://tankandtrench.com/#organization" },
      areaServed: {
        "@type": "Country",
        name: "United States",
      },
      offers: [
        {
          "@type": "Offer",
          name: "Pro",
          price: "750",
          priceCurrency: "USD",
          description: "Full Answer Map, service and town pages, schema, Google Business Profile cleanup, monthly content, review program, AI-answer monitoring, call tracking, and monthly call reporting.",
        },
        {
          "@type": "Offer",
          name: "Territory",
          price: "1250",
          priceCurrency: "USD",
          description: "Everything in Pro, plus county exclusivity for your side (Tank or Trench).",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://tankandtrench.com/pricing/#faq",
      mainEntity: pricingFaqs.map(([name, text]) => ({
        "@type": "Question",
        name,
        acceptedAnswer: { "@type": "Answer", text },
      })),
    },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- Subpage Hero -->
  <section class="section-padding" style="padding-bottom: 24px;">
    <div class="container-narrow text-center">
      <div class="eyebrow sun" style="justify-content: center; margin-bottom: 12px;">Pricing &amp; Territory</div>
      <h1 class="display-xl" style="margin-bottom: 18px;">
        Two plans. One county each.
      </h1>
      <p class="body-lg" style="max-width: 620px; margin: 0 auto; color: var(--text-secondary);">
        Territory reserves one Tank company and one Trench company per county.
      </p>
    </div>
  </section>

  <!-- Core Plans -->
  <section class="section-padding" style="padding-top: 16px;">
    <div class="container">
      <div class="section-header text-center">
        <p class="body-md" style="color: var(--ink-700); max-width: 680px; margin: 0 auto;">
          <strong>Both plans include:</strong> Google profile cleanup, service and town pages, schema, the full Answer Map, monthly content, a review program, AI-answer monitoring, call tracking, and a monthly call report.
        </p>
      </div>

      <div class="pricing-teaser-grid pricing-plan-grid">
        <article class="teaser-plan-card">
          <div>
            <h2 class="teaser-plan-title">Pro</h2>
            <p class="teaser-plan-price">$750 <span>/ month</span></p>
            <p style="margin-top: 12px;">Build your local presence in one county and track the calls and inquiries it brings in.</p>
            <ul style="margin-top: 14px;">
              <li>Full Answer Map, service and town pages, and schema</li>
              <li>Google Business Profile cleanup, monthly content and review program</li>
              <li>AI-answer monitoring, call tracking and monthly reporting</li>
              <li class="website-included-item">
                <span>&#10003; Website included</span>
                <span class="info-popover-wrap" data-info-wrap>
                  <button type="button" class="info-trigger" aria-label="Website included details" aria-expanded="false" data-info-trigger>i</button>
                  <span class="info-popover" role="tooltip" hidden>{websiteTooltipText}</span>
                </span>
              </li>
            </ul>
          </div>
          <a class="btn btn-secondary btn-md" href="/check/#check-form">Get free AI check</a>
        </article>

        <article class="teaser-plan-card featured">
          <div class="pricing-ribbon">County Exclusivity</div>
          <div>
            <h2 class="teaser-plan-title">Territory</h2>
            <p class="teaser-plan-price">$1,250 <span>/ month</span></p>
            <p style="margin-top: 12px;">Everything in Pro, plus we won&rsquo;t work with any other septic or excavation company in your county.</p>
            <ul style="margin-top: 14px;">
              <li>One company per county per side, Tank or Trench</li>
              <li>Tank and Trench each reserve separately</li>
              <li class="website-included-item">
                <span>&#10003; Website included</span>
                <span class="info-popover-wrap" data-info-wrap>
                  <button type="button" class="info-trigger" aria-label="Website included details" aria-expanded="false" data-info-trigger>i</button>
                  <span class="info-popover" role="tooltip" hidden>{websiteTooltipText}</span>
                </span>
              </li>
            </ul>
          </div>
          <a class="btn btn-primary btn-md" href="#county-availability">Check county availability</a>
        </article>
      </div>

      <p class="body-sm text-center" style="color: var(--ink-600); max-width: 720px; margin: 20px auto 0;">
        <em>No website? We build one, included with both plans. 6-month minimum, then month to month. After 6 months, the site is yours.</em>
      </p>

      <!-- Add-ons Section (3-card layout below plans) -->
      <div class="addons-section" id="add-ons">
        <div class="addons-header">
          <p class="addons-kicker">Add-ons (for Pro and Territory clients)</p>
          <h2 class="addons-heading">Want calls sooner? Add ads while AI search builds.</h2>
        </div>

        <div class="addons-grid">
          <!-- Card 1: Ads Bundle: LSA + Search with 3-way toggle -->
          <article class="addon-card addon-card-featured">
            <div class="addon-card-top">
              <h3 class="addon-card-title" data-google-title>Ads Bundle: LSA + Search</h3>
              <span class="addon-popular-tag" data-google-badge>Most popular</span>
            </div>

            <div class="addon-toggle" role="group" aria-label="Google Ads option">
              <button type="button" class="addon-toggle-btn" data-ads-option="lsa" data-title="Local Services Ads" data-price="$300" data-line="Google Guaranteed badge above results" aria-pressed="false">LSA</button>
              <button type="button" class="addon-toggle-btn" data-ads-option="search" data-title="Google Search Ads" data-price="$500" data-line="High-value jobs in your towns" aria-pressed="false">Search</button>
              <button type="button" class="addon-toggle-btn active" data-ads-option="both" data-title="Ads Bundle: LSA + Search" data-price="$700" data-line="LSA + Search managed together" aria-pressed="true">&#10003; Both</button>
            </div>

            <div class="addon-card-meta">
              <div class="addon-price"><span data-google-price>$700</span><span>/mo</span></div>
              <p class="addon-line">
                <span data-google-line>LSA + Search managed together</span>
                <span class="info-popover-wrap" data-info-wrap>
                  <button type="button" class="info-trigger" aria-label="Google Ads details" aria-expanded="false" data-info-trigger>i</button>
                  <span class="info-popover" role="tooltip" hidden>
                    <strong>Local Services Ads ($300/mo):</strong> Google Guaranteed setup, lead disputes, budget and hours tuning, calls in the monthly report.<br><br>
                    <strong>Google Search Ads ($500/mo):</strong> Campaign build, keywords by service and town, weekly bid and search-term cleanup.<br><br>
                    <strong>Ads Bundle ($700/mo):</strong> Both managed together.
                  </span>
                </span>
              </p>
            </div>
          </article>

          <!-- Card 2: Social media -->
          <article class="addon-card">
            <div class="addon-card-top">
              <h3 class="addon-card-title">Social media</h3>
            </div>
            <div class="addon-card-meta">
              <div class="addon-price">$350<span>/mo</span></div>
              <p class="addon-line">
                <span>Job photos &rarr; posts</span>
                <span class="info-popover-wrap" data-info-wrap>
                  <button type="button" class="info-trigger" aria-label="Social media details" aria-expanded="false" data-info-trigger>i</button>
                  <span class="info-popover" role="tooltip" hidden>
                    12 posts a month across Facebook, Instagram, and Google Business Profile, built from your job photos.
                  </span>
                </span>
              </p>
            </div>
          </article>

          <!-- Card 3: Meta ads -->
          <article class="addon-card">
            <div class="addon-card-top">
              <h3 class="addon-card-title">Meta ads</h3>
            </div>
            <div class="addon-card-meta">
              <div class="addon-price">$350<span>/mo</span></div>
              <p class="addon-line">
                <span>Excavation &amp; retargeting</span>
                <span class="info-popover-wrap" data-info-wrap>
                  <button type="button" class="info-trigger" aria-label="Meta ads details" aria-expanded="false" data-info-trigger>i</button>
                  <span class="info-popover" role="tooltip" hidden>
                    One campaign for excavation and land clearing, plus retargeting of site visitors.
                  </span>
                </span>
              </p>
            </div>
          </article>
        </div>

        <p class="addons-footnote">
          Ad spend is paid directly to Google or Meta. Every ad call is tracked and in your monthly report.
        </p>
      </div>
    </div>
  </section>

  <!-- County Availability Checker Section -->
  <section class="section-padding" style="background-color: var(--bg-subtle); border-top: 1px solid var(--border-subtle);" id="county-check">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow cobalt">County Availability</div>
        <h2 class="display-lg">
          Is my county taken?
        </h2>
        <p class="body-lg section-intro">
          The first Territory client on each side reserves that side in the county. Cover more than one county? Ask Joe about adding counties.
        </p>
      </div>

      <div class="county-checker-card" id="county-availability">
        <form id="countyCheckForm" action={contact.formEndpoint} method="POST" data-contact-form data-confirmation="countyConfirmBox">
          <input type="hidden" name="_subject" value="Tank & Trench: County Availability Check">
          <input type="hidden" name="source" value="county-availability-check">
          <div style="margin-bottom: 16px;">
            <label for="cCompany" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Company Name *</label>
            <input id="cCompany" name="company" type="text" class="form-input" placeholder="e.g. Acme Septic Service" required>
          </div>
          <div class="county-fields" style="margin-bottom: 16px;">
            <div>
              <label for="cCounty" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">County *</label>
              <input id="cCounty" name="county" type="text" class="form-input" placeholder="e.g. Worcester County" required>
            </div>
            <div>
              <label for="cState" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">State *</label>
              <input id="cState" name="state" type="text" class="form-input" placeholder="e.g. MA" required>
            </div>
          </div>
          <div class="check-field">
            <label for="cSide">What do you mainly do? *</label>
            <TradeSelect id="cSide" />
            <p class="body-sm" style="color: var(--ink-500); margin-top: 6px;">Septic and excavation territories each reserve separately.</p>
          </div>
          <div class="county-fields" style="margin-bottom: 20px;">
            <div>
              <label for="cPhone" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Phone *</label>
              <input id="cPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" class="form-input" placeholder="e.g. (508) 555-0123" required>
            </div>
            <div>
              <label for="cEmail" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Email *</label>
              <input id="cEmail" name="email" type="email" inputmode="email" autocomplete="email" class="form-input" placeholder="e.g. dave@acmeseptic.com" required>
            </div>
          </div>
          <button class="btn btn-primary btn-lg" type="submit" style="width: 100%;">
            Check County Availability
          </button>
        </form>

        <div id="countyConfirmBox" style="display: none; background: #effdf4; border: 1px solid #86efac; border-radius: var(--radius-lg); padding: 24px; text-align: center; margin-top: 16px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" style="margin-bottom: 8px;">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
          <h3 style="font-size: 18px; color: #166534; margin-bottom: 6px;">County Status Requested</h3>
          <p style="font-size: 14px; color: #14532d; line-height: 1.5; margin: 0;">
            Joe will check current exclusivity status for your county and get back to you directly within one business day.
          </p>
        </div>

        <p class="body-sm" style="margin-top: 14px; text-align: center; color: var(--text-tertiary);">
          You will hear directly from Joe within one business day with territory status.
        </p>
      </div>
    </div>
  </section>

  <!-- Terms Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow sun">Contract Terms</div>
        <h2 class="display-lg">
          Straightforward agreements.
        </h2>
      </div>

      <div class="how-it-works-grid">
        <div class="step-card">
          <h3 class="step-title">6-Month Minimum, Then Month to Month</h3>
          <p class="step-body">
            Long enough to build authority, clean up profiles, and track call volume changes across seasonal cycles. After 6 months, stay month to month.
          </p>
        </div>

        <div class="step-card">
          <h3 class="step-title">You Own Everything</h3>
          <p class="step-body">
            Every page, schema entity, town hub, and profile cleanup stays yours. If we build your website, it&rsquo;s yours after 6 months (or earlier for a $1,500 buyout).
          </p>
        </div>

        <div class="step-card">
          <h3 class="step-title">First-Come Exclusivity</h3>
          <p class="step-body">
            Territory is first come, first served for each side in each county. A Tank contractor and a Trench contractor can hold the same county.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing FAQ -->
  <section class="section-padding" style="background: var(--bg-subtle); border-top: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow cobalt">Pricing &amp; Website Questions</div>
        <h2 class="display-lg">Common questions</h2>
      </div>

      <div class="faq-list">
        {pricingFaqs.map(([question, answer]) => (
          <article class="faq-card">
            <h3 class="faq-q">{question}</h3>
            <p class="faq-a">{answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Final Call to Action -->
  <section class="section-padding" style="background: var(--white); text-align: center; border-top: 1px solid var(--border-subtle);">
    <div class="container-narrow">
      <div class="eyebrow sun" style="justify-content: center; margin-bottom: 12px;">Free AI Check</div>
      <h2 class="display-lg" style="margin-bottom: 20px;">
        Find out what the AI says about you.
      </h2>
      <div style="margin-top: 32px;">
        <a href="/check/" class="btn btn-primary btn-lg">
          <span>Get your free AI check</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <p class="body-sm" style="color: var(--text-tertiary); margin-top: 14px;">
        Takes 30 seconds to request. Your 5-minute video arrives within 2 business days. No sales pitch.
      </p>
    </div>
  </section>

  <script is:inline src="/contact-forms.js" defer></script>
  <script is:inline>
    // Google Ads 3-way toggle
    const adsButtons = document.querySelectorAll('[data-ads-option]');
    const googleTitleEl = document.querySelector('[data-google-title]');
    const googlePriceEl = document.querySelector('[data-google-price]');
    const googleLineEl = document.querySelector('[data-google-line]');
    const googleBadgeEl = document.querySelector('[data-google-badge]');

    adsButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        adsButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        if (googleTitleEl) googleTitleEl.textContent = btn.getAttribute('data-title') || 'Ads Bundle: LSA + Search';
        if (googlePriceEl) googlePriceEl.textContent = btn.getAttribute('data-price') || '$700';
        if (googleLineEl) googleLineEl.textContent = btn.getAttribute('data-line') || '';
        if (googleBadgeEl) {
          googleBadgeEl.hidden = btn.getAttribute('data-ads-option') !== 'both';
        }
      });
    });

    // Accessible (i) popovers: hover on desktop + tap on mobile + close on tap outside
    const infoWraps = document.querySelectorAll('[data-info-wrap]');

    function closeAllPopovers(exceptWrap) {
      infoWraps.forEach((wrap) => {
        if (wrap === exceptWrap) return;
        const trigger = wrap.querySelector('[data-info-trigger]');
        const popover = wrap.querySelector('.info-popover');
        wrap.classList.remove('open');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        if (popover) popover.hidden = true;
      });
    }

    infoWraps.forEach((wrap) => {
      const trigger = wrap.querySelector('[data-info-trigger]');
      const popover = wrap.querySelector('.info-popover');
      if (!trigger || !popover) return;

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = wrap.classList.contains('open');
        closeAllPopovers(isOpen ? null : wrap);
        if (isOpen) {
          wrap.classList.remove('open');
          trigger.setAttribute('aria-expanded', 'false');
          popover.hidden = true;
        } else {
          wrap.classList.add('open');
          trigger.setAttribute('aria-expanded', 'true');
          popover.hidden = false;
        }
      });

      wrap.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          closeAllPopovers(wrap);
          wrap.classList.add('open');
          trigger.setAttribute('aria-expanded', 'true');
          popover.hidden = false;
        }
      });

      wrap.addEventListener('mouseleave', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          wrap.classList.remove('open');
          trigger.setAttribute('aria-expanded', 'false');
          popover.hidden = true;
        }
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('[data-info-wrap]')) {
        closeAllPopovers(null);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeAllPopovers(null);
      }
    });
  </script>
</BaseLayout>
