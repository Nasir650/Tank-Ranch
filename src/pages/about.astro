---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About & Contact | Tank & Trench";
const pageDesc = "Joe and Tank & Trench: AI search exclusively for septic and excavation companies. When homeowners ask who to call, the answer should be you.";
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- Hero / H1 Section -->
  <section class="section-padding" style="padding-bottom: 24px;">
    <div class="container-narrow text-center">
      <div class="eyebrow cobalt" style="justify-content: center; margin-bottom: 12px;">About Tank &amp; Trench</div>
      <h1 class="display-xl" style="margin-bottom: 24px;">
        We do one thing: make septic and excavation companies the answer.
      </h1>
      <p class="body-lg" style="color: var(--text-secondary); max-width: 640px; margin: 0 auto;">
        We aren't a generic marketing agency juggling dentists, florists, and accountants. We work exclusively with owner-operated septic and excavation contractors.
      </p>
    </div>
  </section>

  <!-- Joe's Note -->
  <section class="section-padding" style="padding-top: 24px; padding-bottom: 48px;">
    <div class="container-narrow">
      <div class="joe-note-box">
        <div class="joe-photo-wrap">
          <img src="/images/about-joe-field-audit.jpg" alt="Joe from Tank & Trench" width="160" height="160" loading="lazy">
        </div>
        <div>
          <div class="eyebrow cobalt" style="margin-bottom: 8px;">From Joe</div>
          <p class="joe-quote">
            &ldquo;I'm Joe from Tank &amp; Trench. I've spent years figuring out what makes people click, search and call. Now I do it for one trade only. If a homeowner in your county asks who to call, I want the answer to be you.&rdquo;
          </p>
          <div class="joe-sig">Joe &middot; Tank &amp; Trench</div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Believe Section -->
  <section class="section-padding" style="background: var(--bg-subtle); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow sun">What We Believe</div>
        <h2 class="display-lg">
          Built on trade realities, not agency fluff.
        </h2>
      </div>

      <div class="beliefs-grid">
        <div class="belief-card">
          <div class="step-num-badge" style="margin-bottom: 16px;">01</div>
          <h3 class="step-title" style="margin-bottom: 8px;">Calls matter more than rankings</h3>
          <p class="step-body">
            A #1 ranking for a keyword nobody searches doesn't keep pump trucks rolling. We measure our work in answered phone calls and submitted quote requests. That's the first number in every monthly report.
          </p>
        </div>

        <div class="belief-card">
          <div class="step-num-badge" style="margin-bottom: 16px;">02</div>
          <h3 class="step-title" style="margin-bottom: 8px;">You should own what you pay for</h3>
          <p class="step-body">
            Everything we build belongs to you. Your pages, profiles, schemas, and call tracking stay yours. We never rent pages or hold your digital presence hostage if your contract ends.
          </p>
        </div>

        <div class="belief-card">
          <div class="step-num-badge" style="margin-bottom: 16px;">03</div>
          <h3 class="step-title" style="margin-bottom: 8px;">Honest work beats tricks</h3>
          <p class="step-body">
            We don't buy fake reviews or game algorithms with spam. We map real services, real town permit rules, and real equipment capabilities so AI assistants genuinely understand your company.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Block Section -->
  <section class="section-padding" id="contact">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow cobalt">Get In Touch</div>
        <h2 class="display-lg">
          Direct communication. No account reps.
        </h2>
        <p class="body-lg section-intro">
          Serving septic and excavation companies across the US.
        </p>
      </div>

      <div class="contact-layout">
        <!-- Left: Contact Details -->
        <div class="contact-info-card">
          <div>
            <h3 class="heading-lg" style="color: var(--ink-900); margin-bottom: 8px;">Reach Joe Directly</h3>
            <p class="body-md" style="color: var(--ink-700);">
              Call, text, or email. We respond within one business day.
            </p>
          </div>

          <div class="contact-method-row">
            <div class="contact-icon-bubble">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <div style="font-size: 13px; color: var(--ink-500); font-weight: 500;">Phone &amp; Text</div>
              <div style="font-family: var(--font-mono); font-size: 17px; font-weight: 700; color: var(--ink-900); margin-top: 2px;">
                <a href="tel:5085550198" style="color: inherit; text-decoration: none;">(508) 555-0198</a>
              </div>
            </div>
          </div>

          <div class="contact-method-row">
            <div class="contact-icon-bubble">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div>
              <div style="font-size: 13px; color: var(--ink-500); font-weight: 500;">Email</div>
              <div style="font-family: var(--font-mono); font-size: 16px; font-weight: 700; color: var(--ink-900); margin-top: 2px;">
                <a href="mailto:joe@tankandtrench.com" style="color: inherit; text-decoration: none;">joe@tankandtrench.com</a>
              </div>
            </div>
          </div>

          <div class="contact-method-row">
            <div class="contact-icon-bubble">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <div>
              <div style="font-size: 13px; color: var(--ink-500); font-weight: 500;">Coverage</div>
              <div style="font-size: 15px; font-weight: 600; color: var(--ink-900); margin-top: 2px;">
                Serving septic and excavation companies across the US.
              </div>
              <div style="font-size: 13px; color: var(--ink-500); margin-top: 4px;">(County exclusivity per Territory contract)</div>
            </div>
          </div>
        </div>

        <!-- Right: Short Form -->
        <div class="contact-form-card">
          <h3 class="heading-md" style="margin-bottom: 20px;">Send a message to Joe</h3>
          <form id="aboutContactForm" action="https://formspree.io/f/xbjnbqzz" method="POST">
            <input type="hidden" name="source" value="about-page-form">
            <div style="margin-bottom: 16px;">
              <label for="contactName" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Your Name *</label>
              <input type="text" id="contactName" name="name" required style="width: 100%; height: 46px; border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 0 14px; font-size: 15px;">
            </div>

            <div style="margin-bottom: 16px;">
              <label for="contactCompany" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Company &amp; County *</label>
              <input type="text" id="contactCompany" name="company" placeholder="e.g. Miller Septic, Worcester County MA" required style="width: 100%; height: 46px; border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 0 14px; font-size: 15px;">
            </div>

            <div style="margin-bottom: 16px;">
              <label for="contactInfo" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Phone or Email *</label>
              <input type="text" id="contactInfo" name="contact" required style="width: 100%; height: 46px; border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 0 14px; font-size: 15px;">
            </div>

            <div style="margin-bottom: 20px;">
              <label for="contactBody" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px;">Message (Optional)</label>
              <textarea id="contactBody" name="message" rows="3" placeholder="Tell Joe what town or county you're interested in..." style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 12px 14px; font-size: 15px; font-family: var(--font-body);"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
              Send Message
            </button>
          </form>

          <div id="aboutConfirmBox" style="display: none; background: #effdf4; border: 1px solid #86efac; border-radius: var(--radius-lg); padding: 24px; text-align: center; margin-top: 16px;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" style="margin-bottom: 8px;">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <h3 style="font-size: 18px; color: #166534; margin-bottom: 6px;">Message Received</h3>
            <p style="font-size: 14px; color: #14532d; line-height: 1.5; margin: 0;">
              Thanks for reaching out! Joe will review your message and reply within one business day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const aForm = document.getElementById('aboutContactForm');
    const aBox = document.getElementById('aboutConfirmBox');
    if (aForm && aBox) {
      aForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = aForm.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = 'Sending...';
        try {
          const res = await fetch(aForm.action, {
            method: 'POST',
            body: new FormData(aForm),
            headers: { 'Accept': 'application/json' }
          });
          if (res.ok) {
            aForm.style.display = 'none';
            aBox.style.display = 'block';
          } else {
            aForm.submit();
          }
        } catch(err) {
          aForm.submit();
        }
      });
    }
  </script>
</BaseLayout>
