---
import contact from '../data/contact.json';
import BaseLayout from '../layouts/BaseLayout.astro';

const headline = "When someone asks AI who to call, the answer should be you.";
const pageTitle = "Tank & Trench | " + headline;
const pageDesc = "Homeowners and builders ask ChatGPT, Claude and Google’s AI who pumps septic, clears land or digs foundations. Tank & Trench helps them find you.";
const faqs = [
  ["What is AI search?", "When homeowners or builders ask ChatGPT, Claude or Google’s AI who to call, the assistant may name a few local companies. We help make your services and service area easier to find."],
  ["Do I own what you build?", "Yes, your pages and profiles stay yours."],
  ["How fast does it work?", "It depends on your county and your competition. We report tracked calls and form fills each month so you can follow the results."],
  ["I do septic and excavation. Is that one plan or two?", "Start with one conversation about both services. Joe will scope the work and check availability on both sides if you want Territory exclusivity."],
  ["Most of my work comes from builders, not homeowners. Does this still matter?", "Yes. Builders and general contractors use search to find crews when they need bids, extra capacity or a contractor in a new town. We make your services and coverage clear for those searches."],
  ["Which states do you work in?", "Tell Joe your state and the counties you cover. He’ll confirm whether we can serve your area and which sides are open for Territory."],
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://tankandtrench.com/#organization",
      name: "Tank & Trench",
      legalName: "Shellback Labs LLC",
      url: "https://tankandtrench.com/",
      logo: "https://tankandtrench.com/images/tank-and-trench-logo.svg",
      email: "joe@tankandtrench.com",
      telephone: contact.number,
      description: pageDesc,
    },
    {
      "@type": "FAQPage",
      "@id": "https://tankandtrench.com/#faq",
      mainEntity: faqs.map(([name, text]) => ({
        "@type": "Question",
        name,
        acceptedAnswer: { "@type": "Answer", text },
      })),
    },
  ],
};
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- SECTION 1: HERO -->
  <section class="hero-section" style="padding-top: clamp(48px, 6vw, 84px); padding-bottom: clamp(56px, 7vw, 96px);">
    <div class="hero-mask"></div>

    <div class="container" style="position: relative; z-index: 2;">
      <div class="hero-split-grid">
        <!-- Left: Hero Text -->
        <div class="hero-text-col">
          <div class="eyebrow cobalt" style="margin-bottom: 16px;">AI Search For Septic &amp; Excavation</div>
          <h1 class="display-xl hero-title" style="margin: 0 0 20px;">
            {headline}
          </h1>
          <p class="body-lg hero-desc" style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 32px; max-width: 580px;">
            Homeowners and builders now ask ChatGPT, Claude and Google’s AI who pumps septic tanks, clears land or digs foundations near them. We help them hear your name and track the calls and form fills that follow.
          </p>

          <div class="hero-cta-group" style="margin-bottom: 24px;">
            <a href="/check/" class="btn btn-primary btn-lg">
              <span>Get your free AI check</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <div class="hero-trust">
            <span class="badge-dot"></span>
            <span>Built for a guy in a truck. No jargon. Measured in phone calls.</span>
          </div>
        </div>

        <!-- Right: Hero Scene Visual (AI Search Recommends Contractor) -->
        <div class="hero-scene-wrapper">
          <img src="/ai-hero-scene.svg" alt="AI search recommends a local contractor, with a pump truck and excavator in the scene" width="600" height="640" class="hero-scene-img" loading="eager">
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: THE SHIFT -->
  <section class="shift-section">
    <div class="container">
      <div class="shift-grid">
        <div>
          <div class="eyebrow sun" style="margin-bottom: 12px;">The Shift</div>
          <h2 class="display-lg" style="color: var(--white); margin-bottom: 20px;">
            Ask ChatGPT who to call for septic or site work in your town.
          </h2>
          <p class="body-lg shift-desc">
            If it names a competitor, that could be a pump-out or a site prep bid you never hear about. We make it easier for AI assistants to find your services, the towns you cover and the kind of jobs you take.
          </p>
          <a href="/check/" class="btn btn-inverse btn-md">
            <span>Get your free AI check</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Shift Callout Details -->
        <div class="shift-callout-box">
          <div class="shift-stat-item">
            <div class="shift-stat-icon red">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <div>
              <div style="font-weight: 700; font-size: 15px; color: var(--white); margin-bottom: 4px;">Competitor gets named</div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.7); line-height: 1.5;">A homeowner or GC gets a name to call while looking for a crew.</div>
            </div>
          </div>

          <div class="shift-stat-item">
            <div class="shift-stat-icon green">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <div style="font-weight: 700; font-size: 15px; color: var(--white); margin-bottom: 4px;">Your Answer Map is built</div>
              <div style="font-size: 13px; color: rgba(255, 255, 255, 0.7); line-height: 1.5;">Google and AI assistants understand every town and service you cover. Your phone rings.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding trades-section">
    <div class="container">
      <h2 class="display-lg">Tank side / Trench side</h2>
      <div class="pricing-teaser-grid">
        <article class="step-card">
          <h3 class="step-title">Tank side</h3>
          <p>Septic pumping, installation and repair, wells, and portable toilets.</p>
          <ul>
            <li>“Who pumps septic tanks near me?”</li>
            <li>“Who installs septic systems for new construction in my county?”</li>
            <li>“Who rents portable toilets for a jobsite near me?”</li>
          </ul>
        </article>
        <article class="step-card">
          <h3 class="step-title">Trench side</h3>
          <p>Excavation, site work, land clearing, grading, drainage, sewer and water lines, and boring.</p>
          <ul>
            <li>“Who does land clearing in my town?”</li>
            <li>“Which excavation crew can dig a foundation near me?”</li>
            <li>“Who does directional boring for water lines in my county?”</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION 3: HOW IT WORKS -->
  <section class="section-padding" id="how-it-works">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow cobalt">How It Works</div>
        <h2 class="display-lg">
          Three steps to make you the answer.
        </h2>
        <p class="body-lg section-intro">
          We help homeowners, builders and general contractors find your company when they need a crew.
        </p>
      </div>

      <div class="how-it-works-grid">
        <!-- Step 1 -->
        <div class="step-card">
          <div class="step-num-badge">01</div>
          <h3 class="step-title">We check</h3>
          <p class="step-body">
            We ask Google and the AI assistants who to call in your towns and show you what they say.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="step-card">
          <div class="step-num-badge">02</div>
          <h3 class="step-title">We build your Answer Map</h3>
          <p class="step-body">
            We connect every service and town to the questions your customers ask, from homeowners to builders and general contractors. We build it in the first 30 days and expand it monthly.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="step-card">
          <div class="step-num-badge">03</div>
          <h3 class="step-title">We count the calls</h3>
          <p class="step-body">
            Tracked numbers from day one, and one line first in every report, how many times your phone rang.
          </p>
        </div>
      </div>

      <div style="text-align: center; margin-top: 40px;">
        <a href="/check/" class="btn btn-primary btn-md">Get your free AI check</a>
      </div>
    </div>
  </section>

  <!-- SECTION 4: PROOF -->
  <section class="section-padding" style="padding-top: 0;">
    <div class="container">
      <div class="proof-banner">
        <div>
          <div class="proof-big-stat">40+</div>
          <div class="proof-stat-caption">Engagements in the past month</div>
        </div>
        <div>
          <div class="eyebrow mint" style="margin-bottom: 8px;">Real Proof</div>
          <p class="proof-quote-text">
            A New England hardscape and paving contractor reported 40+ engagements in the past month. Daily search impressions grew from about 80 to 5,000+.
          </p>
          <p class="proof-disclaimer">
            We track phone calls and form fills alongside search impressions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: PRICING TEASER -->
  <section class="section-padding" id="pricing-teaser" style="background: var(--bg-subtle); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow sun">Pricing Teaser</div>
        <h2 class="display-lg">
          Two plans. One county each.
        </h2>
      </div>

      <div class="pricing-teaser-grid">
        <!-- Pro Plan Teaser -->
        <div class="teaser-plan-card">
          <div>
            <div class="teaser-plan-header">
              <h3 class="teaser-plan-title">Pro</h3>
              <div class="teaser-plan-price">$750 <span>/ mo</span></div>
            </div>
            <p class="teaser-plan-body" style="margin-top: 14px;">
              Built for owners ready to own their county. Includes Google Business Profile cleanup, service and town pages, schema, the full Answer Map, monthly content, call tracking, and monthly call reporting.
            </p>
          </div>
          <div>
            <a href="/pricing/" class="btn btn-secondary btn-md" style="width: 100%; text-align: center;">See Pro details</a>
          </div>
        </div>

        <!-- Territory Plan Teaser -->
        <div class="teaser-plan-card featured">
          <div class="pricing-ribbon">County Exclusivity</div>
          <div>
            <div class="teaser-plan-header">
              <h3 class="teaser-plan-title">Territory</h3>
              <div class="teaser-plan-price">$1,250 <span>/ mo</span></div>
            </div>
            <p class="teaser-plan-body" style="margin-top: 14px;">
              Everything in Pro, plus county exclusivity for your side, Tank or Trench, and leads from our county lead sites.
            </p>
          </div>
          <div>
            <a href="/pricing/" class="btn btn-primary btn-md" style="width: 100%; text-align: center;">See Territory details</a>
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: center; gap: 16px; margin-top: 36px; flex-wrap: wrap;">
        <a href="/pricing/" class="btn btn-primary btn-md">See pricing</a>
        <a href="/pricing/#county-check" class="btn btn-secondary btn-md">Is my county taken?</a>
      </div>
    </div>
  </section>

  <!-- SECTION 6: A NOTE FROM JOE -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="joe-note-box">
        <div class="joe-photo-wrap">
          <img src="/images/about-joe-field-audit.jpg" alt="Joe from Tank & Trench working on field audits" width="160" height="160" loading="lazy">
        </div>
        <div>
          <div class="eyebrow cobalt" style="margin-bottom: 8px;">A Note from Joe</div>
          <p class="joe-quote">
            &ldquo;I'm Joe from Tank &amp; Trench. I've spent years figuring out what makes people click, search and call. Now I do it for septic and excavation contractors. When a homeowner or builder in your county asks who to call, I want the answer to be you.&rdquo;
          </p>
          <div class="joe-sig">Joe &middot; Tank &amp; Trench</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: FAQ -->
  <section class="section-padding" style="background: var(--bg-subtle); border-top: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-header text-center">
        <div class="eyebrow cobalt">Straight Answers</div>
        <h2 class="display-lg">
          Frequently Asked Questions
        </h2>
        <p class="body-lg section-intro">
          No jargon, no runaround. Exactly how we operate.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <article class="faq-card">
            <h3 class="faq-q">{question}</h3>
            <p class="faq-a">{answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 8: FINAL CALL TO ACTION -->
  <section class="section-padding" style="background: var(--white); text-align: center;">
    <div class="container-narrow">
      <div class="eyebrow sun" style="justify-content: center; margin-bottom: 12px;">Free AI Check</div>
      <h2 class="display-lg" style="margin-bottom: 20px;">
        Find out what the AI says about you. Free, five minutes of your time, and you get a short video walkthrough.
      </h2>
      <div style="margin-top: 32px;">
        <a href="/check/" class="btn btn-primary btn-lg">
          <span>Get your free AI check</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <p class="body-sm" style="color: var(--text-tertiary); margin-top: 14px;">
        Takes 30 seconds to request &middot; Delivered in two business days &middot; No sales pitch
      </p>
    </div>
  </section>
</BaseLayout>
