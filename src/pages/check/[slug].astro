---
import { parse } from 'csv-parse/sync';
import BaseLayout from '../../layouts/BaseLayout.astro';
import contact from '../../data/contact.json';
import csvRaw from '../../data/postcards.csv?raw';

export const prerender = true;

export async function getStaticPaths() {
  const records = parse(csvRaw, {
    columns: true,
    skip_empty_lines: true,
    trim: true,
  });

  return records.filter((record: any) => record.slug).map((record: any) => ({
    params: { slug: record.slug },
    props: { record },
  }));
}

const { record } = Astro.props;

const result = (record.company_named || '').toLowerCase();
const firstName = record.owner_first_name || 'there';
const town = record.city || '';
const location = [town, record.state].filter(Boolean).join(', ');
const company = record.company || 'Your company';
const aiAssistant = record.ai_assistant || 'ChatGPT';
const trade = record['Card line'] || record.card_line || 'local contractors';
const questionAsked = record.question_asked;
const screenshot = record.screenshot;
const fixes = [record.fix_1, record.fix_2, record.fix_3].filter(Boolean);
const rawDate = record.date_checked;
const date = rawDate && new Date(rawDate + 'T00:00:00Z');
const displayDate = date && !Number.isNaN(date.valueOf())
  ? new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(date)
  : rawDate;
const textJoe = 'sms:' + contact.number + '?&body=' + encodeURIComponent('Hi Joe, this is ' + firstName + ' from ' + company + '.');
const heading = "Here’s what " + aiAssistant + " said about " + trade + " in " + location + ".";
const pageTitle = company + " | " + heading + " | Tank & Trench";
const pageDesc = "The postcard check for " + company + " in " + location + ".";
---

<BaseLayout title={pageTitle} description={pageDesc} noindex={true} textHref={textJoe} postcardOnly>
  <section class="section-padding personal-check">
    <div class="container-narrow">
      <p class="eyebrow cobalt">Did it say your name?</p>
      <h1 class="display-lg">{heading}</h1>
      <p class="body-md">This check is for {company}. When your name is missing, that could mean work going down the road.</p>
      <a href={textJoe} class="btn btn-primary btn-lg personal-text">Text Joe</a>
      <a href="#video-request" class="personal-video-link">Get my 5-minute video</a>

      <section class="personal-result">
        <h2 class="heading-lg">The question we asked</h2>
        {questionAsked ? <blockquote>{questionAsked}</blockquote> : <p>Question unavailable.</p>}
        <p>{displayDate ? <time datetime={rawDate}>Checked {displayDate}</time> : 'Check date unavailable.'}</p>
        {screenshot ? (
          <figure>
            <a href={'/checks/' + encodeURIComponent(screenshot)}>
              <img src={'/checks/' + encodeURIComponent(screenshot)} alt={'Screenshot of the ' + aiAssistant + ' answer'} onerror="this.closest('figure').hidden = true; this.closest('figure').nextElementSibling.hidden = false;">
            </a>
            <figcaption><a href={'/checks/' + encodeURIComponent(screenshot)}>Open full screenshot</a></figcaption>
          </figure>
          <p hidden>Screenshot unavailable.</p>
        ) : <p>Screenshot unavailable.</p>}
        <h2 class="heading-lg">Who {aiAssistant} named</h2>
        <p>{record.ai_named || 'Results are unavailable for this question.'}</p>
        {result === 'yes' && <p><strong>{company} appeared in the answer.</strong></p>}
        {result === 'no' && <p><strong>{company} did not appear in the answer.</strong></p>}
      </section>

      {fixes.length > 0 && (
        <section class="personal-result">
          <h2 class="heading-lg">{fixes.length === 3 ? 'Three fixes for your company' : 'What to fix first'}</h2>
          <ol>{fixes.map((fix: string) => <li>{fix}</li>)}</ol>
        </section>
      )}

      <section class="personal-result" id="video-request">
        <h2 class="heading-lg">Get my 5-minute video</h2>
        <p>Joe will walk through what came up and what to fix first.</p>
        <form data-video-request action="https://formspree.io/f/xbjnbqzz" method="POST">
          <input type="hidden" name="company" value={company}>
          <input type="hidden" name="slug" value={record.slug}>
          <input type="hidden" name="city" value={town}>
          <input type="hidden" name="state" value={record.state}>
          <input type="hidden" name="trade" value={trade}>
          <input type="hidden" name="wave" value={record.wave || '1'}>
          <input type="hidden" name="source" value="postcard-check-page">
          <div class="check-field">
            <label for="auditPhone">Your mobile number</label>
            <input type="tel" id="auditPhone" name="phone" class="form-input" autocomplete="tel" required>
          </div>
          <button type="submit" class="btn btn-primary btn-lg">Get my 5-minute video</button>
        </form>
        <p role="status" tabindex="-1" hidden></p>
      </section>

    </div>
  </section>

  <script is:inline src="/postcard-video.js" defer></script>
</BaseLayout>
